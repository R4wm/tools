# cloudflare-ddns configuration
# Copy to /etc/cloudflare-ddns/config.env (chmod 600) and fill in real values.
# This file is read as an environment file; do NOT commit the filled-in copy.

# Cloudflare API token, scoped: Zone -> DNS -> Edit  AND  Zone -> Zone -> Read
# Create at: https://dash.cloudflare.com/profile/api-tokens (use the
# "Edit zone DNS" template, limited to the one zone below).
CF_API_TOKEN=

# Your zone / apex domain, e.g. example.com
CF_DOMAIN=

# Record to keep pointed at your home IP. Defaults to CF_DOMAIN if blank.
# Examples: example.com  (apex)   |   home.example.com  (subdomain)
CF_RECORD=

# TTL in seconds. 1 means "automatic". 300 is a good default for DDNS.
CF_TTL=300

# Proxy through Cloudflare? Keep false (DNS-only) when port-forwarding arbitrary
# ports to a home server, so traffic reaches your IP directly. Set true only if
# you exclusively serve HTTP/HTTPS through Cloudflare's proxy.
CF_PROXIED=false
