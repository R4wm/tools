[Unit]
Description=HTTP speed test server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=speedtest
Group=speedtest
ExecStart=/usr/local/bin/speedtest-server -port 8080 -download-duration 10s -max-downloads 20
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
